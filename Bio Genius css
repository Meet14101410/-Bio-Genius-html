body{
  margin:0;
  display:flex;
  justify-content:center;
  align-items:center;
  height:100vh;
  background:#dff6e3;
  font-family:Arial,sans-serif;
}

.game{
  text-align:center;
  background:#fff;
  padding:20px;
  border-radius:10px;
  box-shadow:0 4px 10px rgba(0,0,0,.2);
}

h1{
  color:#2e8b57;
}

button{
  padding:10px 20px;
  border:none;
  border-radius:5px;
  background:#2e8b57;
  color:#fff;
  cursor:pointer;
}

button:hover{
  background:#246b45;
}
